{
  "name": "@company-in-a-box/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./org": {
      "types": "./dist/org/index.d.ts",
      "import": "./dist/org/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "import": "./dist/tasks/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence/index.d.ts",
      "import": "./dist/evidence/index.js"
    },
    "./finance": {
      "types": "./dist/finance/index.d.ts",
      "import": "./dist/finance/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "import": "./dist/approvals/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "db:push": "tsx src/db/push.ts",
    "db:studio": "tsx src/db/studio.ts",
    "api": "tsx src/api/server.ts"
  },
  "dependencies": {
    "@company-in-a-box/taxonomy": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.0.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.16",
    "jose": "^5.6.0",
    "stripe": "^16.0.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
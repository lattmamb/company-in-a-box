{
  "name": "@company-in-a-box/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./org": {
      "types": "./dist/org/index.d.ts",
      "import": "./dist/org/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "import": "./dist/tasks/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence/index.d.ts",
      "import": "./dist/evidence/index.js"
    },
    "./finance": {
      "types": "./dist/finance/index.d.ts",
      "import": "./dist/finance/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "import": "./dist/approvals/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "db:push": "tsx src/db/push.ts",
    "db:studio": "tsx src/db/studio.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.8.0",
    "better-auth": "^1.0.0",
    "zod": "^3.23.0",
    "drizzle-orm": "^0.33.0",
    "ulid": "^2.3.0",
    "jose": "^5.6.0",
    "bcryptjs": "^2.4.3",
    "stripe": "^16.0.0",
    "@company-in-a-box/taxonomy": "workspace:*",
    "@company-in-a-box/runtime": "workspace:*",
    "@company-in-a-box/gateway": "workspace:*",
    "@company-in-a-box/memory": "workspace:*",
    "@company-in-a-box/skills": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "drizzle-kit": "^0.24.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0"
  }
}